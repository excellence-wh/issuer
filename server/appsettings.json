{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:3001",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithProperty" ],
    "Properties": {
      "Application": "IssuerServer"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "D:\\applications\\IssuerServer\\logs/\\ssurerserver-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "WindowsService": {
    "ServiceName": "IssuerServer",
    "DisplayName": "Excellence Issuer Server",
    "Description": "提供 Hg 版本控制、Redmine 项目管理、MiMo LLM 集成的 REST API 服务"
  }
  ,
  "PortMonitor": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "Host": "127.0.0.1",
    "Port": 6060,
    "TimeoutMs": 2000,
    "Command": "cmd.exe",
    "Args": "/c \"npm i && npm run start\"",
    "WorkingDirectory": "D:\\excellence.wh\\projects\\sql-task-manager",
    "MaxRetries": 1,
    "RetryBackoffSeconds": 30
  }
}
